<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>For My Favorite Person 💗</title>

<style>
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Georgia, serif;
    color: #64243f;
    background:
        radial-gradient(circle at top, #fff8fb 0%, #ffd9e8 45%, #f7b8d0 100%);
    overflow-x: hidden;
}

.page {
    min-height: 100vh;
    padding: 70px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.card {
    width: 100%;
    max-width: 650px;
    padding: 35px 25px;
    margin: 20px auto;
    text-align: center;
    background: rgba(255,255,255,0.72);
    border: 1px solid rgba(255,255,255,0.8);
    border-radius: 30px;
    box-shadow: 0 15px 40px rgba(120,40,80,0.15);
    backdrop-filter: blur(12px);
}

h1 {
    font-size: clamp(38px, 10vw, 65px);
    margin: 10px 0;
}

h2 {
    font-size: 30px;
}

p {
    font-size: 18px;
    line-height: 1.8;
}

.small {
    font-size: 15px;
    opacity: 0.75;
}

button {
    border: none;
    padding: 16px 28px;
    border-radius: 50px;
    background: #e85d91;
    color: white;
    font-size: 17px;
    font-family: Georgia, serif;
    cursor: pointer;
    margin-top: 15px;
    box-shadow: 0 8px 20px rgba(180,50,100,0.25);
    transition: 0.3s;
}

button:hover {
    transform: scale(1.06);
}

button:active {
    transform: scale(0.96);
}

.hidden {
    display: none;
}

.reason {
    background: rgba(255,255,255,0.55);
    margin: 12px 0;
    padding: 12px;
    border-radius: 18px;
}

.photo-box {
    width: 100%;
    height: 280px;
    border-radius: 22px;
    background: linear-gradient(135deg, #f6a9c5, #ffe4ef);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 60px;
    margin: 20px 0;
}

.heart {
    position: fixed;
    bottom: -40px;
    pointer-events: none;
    animation: floatUp linear forwards;
    z-index: 999;
}

@keyframes floatUp {
    from {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
    }

    to {
        transform: translateY(-115vh) rotate(360deg);
        opacity: 0;
    }
}

footer {
    text-align: center;
    padding: 30px;
    font-size: 14px;
}
</style>
</head>

